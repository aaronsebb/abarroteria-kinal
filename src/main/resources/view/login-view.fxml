<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="900.0" styleClass="main-pane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.javatesting.kinalproyect.controller.LoginController">
    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>
    <children>
        <StackPane styleClass="background-pane" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <VBox alignment="CENTER" maxHeight="480" maxWidth="380" spacing="18.0" styleClass="login-card">
                <VBox alignment="CENTER" spacing="8">
                    <Label styleClass="app-title" text="Abarroteria kinal" />
                    <Label styleClass="subtitle" text="Inicia sesión en tu cuenta" />
                </VBox>
                <VBox spacing="6" styleClass="field-group">
                    <Label styleClass="field-label" text="Correo electrónico" />
                    <TextField fx:id="txtFieldEmail" promptText="ejemplo@correo.com" styleClass="input-field" />
                </VBox>
                <VBox spacing="6" styleClass="field-group">
                    <Label styleClass="field-label" text="Contraseña" />
                    <PasswordField fx:id="txtFieldPass" promptText="••••••••" styleClass="input-field" />
                </VBox>
                <VBox spacing="12" styleClass="button-group">
                    <Button fx:id="btnIniciarSesion" maxWidth="Infinity" mnemonicParsing="false" styleClass="btn-primary" text="Iniciar sesión" onAction="#handleLogin" />
                    <HBox alignment="CENTER" spacing="6">
                        <Label styleClass="helper-text" text="¿No tienes cuenta?" />
                        <Button fx:id="btnRegistrar" mnemonicParsing="false" styleClass="btn-link" text="Regístrate" onAction="#handleIrRegistro" />
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </children>
</AnchorPane>