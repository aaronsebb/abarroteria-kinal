<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="900.0"
            styleClass="main-pane"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javatesting.kinalproyect.controller.RegistroController">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <children>
        <StackPane AnchorPane.topAnchor="0.0" 
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0" 
                   AnchorPane.rightAnchor="0.0"
                   styleClass="background-pane">

            <VBox alignment="CENTER" 
                  spacing="14.0"
                  styleClass="login-card"
                  maxWidth="400.0" 
                  maxHeight="620.0">

                <VBox alignment="CENTER" spacing="6.0">
                    <Label text="Crear Cuenta" styleClass="app-title"/>
                    <Label text="Regístrate para continuar" styleClass="subtitle"/>
                </VBox>

                <VBox spacing="5.0" styleClass="field-group">
                    <Label text="Nombre" styleClass="field-label"/>
                    <TextField fx:id="txtNombre" 
                               promptText="Ej: Jose"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="5.0" styleClass="field-group">
                    <Label text="Apellido" styleClass="field-label"/>
                    <TextField fx:id="txtApellido" 
                               promptText="Ej: Perez"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="5.0" styleClass="field-group">
                    <Label text="Correo electrónico" styleClass="field-label"/>
                    <TextField fx:id="txtEmail" 
                               promptText="ejemplo@correo.com"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="5.0" styleClass="field-group">
                    <Label text="Contraseña" styleClass="field-label"/>
                    <PasswordField fx:id="txtPassword" 
                                   promptText="••••••••"
                                   styleClass="input-field"/>
                </VBox>

                <VBox spacing="5.0" styleClass="field-group">
                    <Label text="Confirmar contraseña" styleClass="field-label"/>
                    <PasswordField fx:id="txtConfirmPassword" 
                                   promptText="••••••••"
                                   styleClass="input-field"/>
                </VBox>

                <VBox spacing="12.0" styleClass="button-group">
                    <Button text="Registrarse" 
                            styleClass="btn-primary"
                            maxWidth="Infinity"
                            mnemonicParsing="false"
                            fx:id="btnRegistrar"
                            onAction="#onRegistrar"/>

                    <HBox alignment="CENTER" spacing="6.0">
                        <Label text="¿Ya tienes cuenta?" styleClass="helper-text"/>
                        <Button text="Inicia sesión" 
                                styleClass="btn-link"
                                mnemonicParsing="false"
                                fx:id="btnIrLogin"
                                onAction="#onIrLogin"/>
                    </HBox>
                </VBox>

            </VBox>
        </StackPane>
    </children>
</AnchorPane>